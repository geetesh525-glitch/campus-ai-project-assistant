# Campus AI Environment Configuration

# Application
PROJECT_NAME="Campus AI"
API_V1_PREFIX="/api"

# AI / LLM
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Database (Default: SQLite local database for instant zero-config setup)
DATABASE_URL="sqlite:///./campus_ai.db"

# Optional Supabase Integration (PostgreSQL)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
